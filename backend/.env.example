# For Vercel Deployment - Use MongoDB Atlas
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/hirescore

# JWT Secret - Generate a strong secret for production
JWT_SECRET=your-super-secret-jwt-key-here-change-in-production

# Frontend URL - Update with your Vercel frontend URL
FRONTEND_ORIGIN=https://your-frontend-project.vercel.app

# Upload Directory
UPLOAD_DIR=uploads

# GitHub API Configuration
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_TOKEN=your_github_token

# Groq AI Configuration
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.1-8b-instant

# Existing Verification Module URL
EXISTING_VERIFICATION_MODULE_URL=https://your-backend-project.vercel.app/api/verify/full

# For local development (comment out for Vercel)
# PORT=5000
# MONGODB_URI=mongodb://127.0.0.1:27017/hirescore
# FRONTEND_ORIGIN=http://localhost:3000
